# === Gateway (auth endpoints + proxy to content-service / user-community) ===
GATEWAY_URL=http://localhost:3005

# === Google OAuth ===
# The platform's Google Web client — MUST be the same client_id the gateway uses
# (env GOOGLE_CLIENT_ID_WEB on gateway-auth-service), else login-google rejects the id_token audience.
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_SECRET_WEB=
# Register this exact URI in Google Cloud Console → OAuth client → Authorized redirect URIs.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/callback
GOOGLE_OAUTH_PORT=8787

# === Posting target ===
# The community to post into. The account must be OWNER or have POST_CONTENT permission here.
COMMUNITY_ID=
LAYOUT_TYPE=CLASSIC

# === RSS source (mode=run / mode=rss). Prefer safe feeds (tech/sports/entertainment)
# to avoid the profanity filter rejecting news on sensitive topics. ===
RSS_FEED_URL=https://vnexpress.net/rss/tin-moi-nhat.rss
RSS_LIMIT_PER_CYCLE=1

# === Continuous loop ===
POST_INTERVAL_MS=900000
DRY_RUN=false

# === Stable device identity (fake is fine — kept stable across runs). ===
DEVICE_INSTALLATION_ID=11111111-1111-4111-8111-111111111111
DEVICE_FINGERPRINT=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# === Persisted state (gitignored — do not commit) ===
SESSION_FILE=.session.json
DEDUP_FILE=posted.json

# === AI rewrite (paraphrase → tránh bản quyền + profanity 40001) ===
# Anthropic-compatible relay (default ai-box.vn). REWRITE_WITH_AI=true: scrape full → LLM viết lại → post.
REWRITE_WITH_AI=true
LLM_BASE_URL=https://api.ai-box.vn
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash[1m]

# === Web GUI (v1) ===
# Server GUI nhúng. GUI_HOST=0.0.0.0 BẮT BUỘC kèm GUI_TOKEN (từ chối khởi động nếu thiếu).
GUI_HOST=127.0.0.1
GUI_PORT=8899
GUI_TOKEN=
